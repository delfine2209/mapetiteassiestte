src/styles/:root {
  --cream: #FFF9F2;
  --terracotta: #D97A5A;
  --brown: #4A2E1F;
  --white: #FFFFFF;
  --soft-green: #A7C4A0;
}

body {
  font-family: 'Nunito', sans-serif;
  background-color: var(--cream);
  color: var(--brown);
  margin: 0;
  padding: 0;
}

h1 {
  font-size: 28px;
  font-weight: 700;
}

h2 {
  font-size: 20px;
  font-weight: 600;
}

p {
  font-size: 18px;
}
.screen {
  padding: 24px;
}

.card {
  background-color: var(--white);
  padding: 20px;
  border-radius: 20px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
  margin-bottom: 16px;
}

.button {
  background-color: var(--terracotta);
  color: var(--white);
  padding: 16px;
  border-radius: 16px;
  font-size: 18px;
  text-align: center;
  display: block;
  margin-top: 24px;
}
